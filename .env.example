# database
DATABASE_URL=postgresql+psycopg://noetra:noetra@db:5432/noetra
# redis / celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
# github oauth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK=http://localhost:8000/api/v1/auth/callback
FRONTEND_URL=http://localhost:5173
# ai — embeddings are Gemini-only (Anthropic has no embedding API); chat is switchable
# via core/ai/chat.py::get_chat_model(provider). All read only by core/ai.
# get a key at https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=1536   # must match chunk.embedding's vector(N); changing it = full re-embed
DEFAULT_CHAT_PROVIDER=gemini       # gemini | openai | anthropic — which get_chat_model() builds by default
OPENAI_API_KEY=                   # only needed if testing the chat agent against OpenAI
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=                 # only needed if testing the chat agent against Anthropic
ANTHROPIC_CHAT_MODEL=claude-sonnet-5
# app
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
CLONE_STORAGE_DIR=/data/repos  # where the worker clones repos
# eval harness — a GitHub token that can read the private noetra repo (public eval repos need no auth)
EVAL_GITHUB_TOKEN=
